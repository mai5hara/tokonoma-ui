    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-storybook": "^10.1.8",
    "globals": "^16.5.0",
    "lucide-react": "^1.16.0",
    "playwright": "^1.57.0",
    "react": "^19.2.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.0",
    "storybook": "^10.1.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.9.3",
